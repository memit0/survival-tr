(version 1)
(allow default)
; No network at all, except accepting connections on this computer.
(deny network*)
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
; Can only write inside .local and macOS temp/cache folders.
(deny file-write*)
(allow file-write*
  (subpath (param "LOCAL"))
  (subpath "/private/var/folders")
  (subpath "/private/tmp")
  (subpath "/dev"))
